{
  "name": "bb-plugin-chatgpt-theme",
  "version": "0.2.1",
  "description": "Restyle bb to match the OpenAI ChatGPT (Codex) desktop app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariofrio/bb-plugins.git",
    "directory": "plugins/bb-plugin-chatgpt-theme"
  },
  "homepage": "https://github.com/ariofrio/bb-plugins/tree/main/plugins/bb-plugin-chatgpt-theme#readme",
  "bugs": {
    "url": "https://github.com/ariofrio/bb-plugins/issues"
  },
  "files": [
    "assets",
    "!assets/screenshot*.png",
    "dist",
    "src",
    "themes"
  ],
  "type": "module",
  "scripts": {
    "build": "bb plugin build",
    "verify:types": "node ../../scripts/verify-types.mjs",
    "verify:package": "node ../../scripts/verify-package.mjs",
    "release:check": "npm run typecheck && npm run verify:types && npm run build && npm run verify:package",
    "prepublishOnly": "npm run release:check",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bb": ">=0.39",
    "bbPluginSdk": "^0.4.8"
  },
  "bb": {
    "name": "ChatGPT theme",
    "description": "Restyle bb to match the OpenAI ChatGPT (Codex) desktop app.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./src/server.ts",
    "skills": [],
    "themes": [
      {
        "id": "chatgpt",
        "name": "ChatGPT",
        "description": "Colors and shadows measured from the OpenAI ChatGPT desktop app.",
        "css": "./themes/chatgpt.css"
      }
    ]
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.8",
    "@types/node": "^22.0.0",
    "bb-app": "0.39.0",
    "typescript": "^5.7.0"
  }
}
