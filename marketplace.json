{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "ariofrio",
  "displayName": "Andres Riofrio's bb plugins",
  "description": "Plugins for bb maintained by Andres Riofrio.",
  "plugins": [
    {
      "id": "chatgpt-theme",
      "displayName": "ChatGPT theme",
      "description": "Restyle bb to match the OpenAI ChatGPT (Codex) desktop app.",
      "icon": {
        "url": "./plugins/bb-plugin-chatgpt-theme/assets/icon.svg"
      },
      "tags": [
        "theme",
        "appearance",
        "light",
        "dark",
        "chatgpt",
        "codex"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/bb-plugins.git",
          "subdir": "plugins/bb-plugin-chatgpt-theme",
          "range": "*",
          "tagPrefix": "chatgpt-theme/"
        }
      }
    },
    {
      "id": "missing-keyboard-shortcuts",
      "displayName": "Missing keyboard shortcuts",
      "description": "Add shortcuts to start personal or project threads, navigate history, and reach the composer or panel tabs.",
      "icon": {
        "url": "./plugins/bb-plugin-missing-keyboard-shortcuts/assets/icon.svg"
      },
      "tags": [
        "keyboard-shortcuts",
        "navigation",
        "threads",
        "interface",
        "productivity"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/bb-plugins.git",
          "subdir": "plugins/bb-plugin-missing-keyboard-shortcuts",
          "range": "*",
          "tagPrefix": "missing-keyboard-shortcuts/"
        }
      }
    },
    {
      "id": "project-breadcrumbs",
      "displayName": "Project breadcrumbs",
      "description": "Show and manage a thread's project from its header.",
      "icon": {
        "url": "./plugins/bb-plugin-project-breadcrumbs/assets/icon.svg"
      },
      "tags": [
        "interface",
        "projects",
        "navigation",
        "threads"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/bb-plugins.git",
          "subdir": "plugins/bb-plugin-project-breadcrumbs",
          "range": "*",
          "tagPrefix": "project-breadcrumbs/"
        }
      }
    },
    {
      "id": "project-icons",
      "displayName": "Project icons",
      "description": "Give each project an icon and color.",
      "icon": {
        "url": "./plugins/bb-plugin-project-icons/assets/icon.svg"
      },
      "tags": [
        "projects",
        "icons",
        "colors",
        "interface",
        "sidebar"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/bb-plugins.git",
          "subdir": "plugins/bb-plugin-project-icons",
          "range": "*",
          "tagPrefix": "project-icons/"
        }
      }
    },
    {
      "id": "thread-stages",
      "displayName": "Thread stages",
      "description": "Group threads in the sidebar into stages from Backlog to Done, updating as they run.",
      "icon": {
        "url": "./plugins/bb-plugin-thread-stages/assets/icon.svg"
      },
      "tags": [
        "stages",
        "sidebar",
        "threads",
        "productivity",
        "keyboard-shortcuts",
        "cli"
      ],
      "author": {
        "name": "Andres Riofrio",
        "github": "ariofrio",
        "url": "https://github.com/ariofrio"
      },
      "source": {
        "git": {
          "url": "https://github.com/ariofrio/bb-plugins.git",
          "subdir": "plugins/bb-plugin-thread-stages",
          "range": "*",
          "tagPrefix": "thread-stages/"
        }
      }
    }
  ]
}
